# Copy to .env; credentials are read by the server only, never exposed to Vite.
# Restart npm run dev after editing. Do not prefix secrets with VITE_.
STRIPE_SECRET_KEY=
MERCURY_API_TOKEN=
CLOUDFLARE_API_TOKEN=
# GCP standard/detailed billing export table and query project.
GCP_BILLING_PROJECT=
GCP_BILLING_TABLE=
GCP_BILLING_LOCATION=US
# Optional: service-account JSON path; otherwise uses Application Default Credentials.
GOOGLE_APPLICATION_CREDENTIALS=
API_PORT=4174
DATA_DIR=.data
